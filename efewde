local function updateWalkRefs()
    walkCharacter = player.Character or player.CharacterAdded:Wait()
    walkHRP = walkCharacter:WaitForChild("HumanoidRootPart")
    walkHumanoid = walkCharacter:WaitForChild("Humanoid")
