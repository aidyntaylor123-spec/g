local function mapCategory(title)
    if title == "Settings" then
        return "Utility"
    end
    if title == "Main" or title == "Player" or title == "Premium" then
        return "Gameplay"
    end
    if title == "Target Player" or title == "Combat" or title == "Misc" then
        return "Targeting"
    end
    return "Utility"
end

